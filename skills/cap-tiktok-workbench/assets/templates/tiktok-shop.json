{
 "schema": "cap-workbench/1",
 "company": {
  "name": "示例 · TikTok 跨境店",
  "slogan": "一个人 · 六个 AI 岗位 · 卖向东南亚",
  "mark": "示",
  "industry": "tiktok-shop",
  "markets": [
   "MY",
   "TH",
   "PH"
  ],
  "team_size": 1,
  "audience": "clients"
 },
 "theme": {
  "main_scene": "pixel-office",
  "palette": "cyber",
  "role_default": "neural-galaxy",
  "fx": [
   "grid",
   "stars"
  ],
  "motion": "normal",
  "celebrate": "fireworks",
  "opening": "boot"
 },
 "roles": [
  {
   "id": "chief",
   "name": "统筹助理",
   "title": "把老板的一句话拆成每个岗位的活",
   "mark": "统",
   "keywords": [
    "安排",
    "计划",
    "汇总",
    "日报",
    "周报",
    "统筹"
   ],
   "duties": [
    "拆解老板的指令",
    "汇总各岗位进度",
    "整理今日日报"
   ],
   "outputs": [
    "任务拆解单",
    "今日日报"
   ],
   "module": "node-matrix",
   "executor": {
    "skill": "cap-skill",
    "connected": false
   }
  },
  {
   "id": "scout",
   "name": "选品专家",
   "title": "每天从榜单里挑能赚钱的品",
   "mark": "选",
   "keywords": [
    "选品",
    "爆品",
    "找品",
    "商品",
    "竞品",
    "榜单"
   ],
   "duties": [
    "扫描 TikTok Shop 热销榜",
    "评估候选商品利润",
    "对比竞品价格"
   ],
   "outputs": [
    "候选商品清单",
    "竞品对比表"
   ],
   "module": "globe",
   "socket": "FastMoss 或 TikTok Shop 热销榜导出",
   "executor": {
    "skill": "cap-tiktok-selection",
    "connected": false
   }
  },
  {
   "id": "content",
   "name": "内容专家",
   "title": "脚本、钩子、短视频一条龙",
   "mark": "内",
   "flow": "content",
   "keywords": [
    "视频",
    "脚本",
    "文案",
    "内容",
    "钩子",
    "口播"
   ],
   "duties": [
    "改写爆款脚本",
    "生成 3 个开头钩子",
    "检查字幕与配音"
   ],
   "outputs": [
    "带货脚本",
    "钩子合集",
    "成片清单"
   ],
   "module": "pipeline",
   "executor": {
    "skill": "cap-tiktok-breakdown",
    "connected": false
   }
  },
  {
   "id": "ads",
   "name": "投流专家",
   "title": "盯预算、看 ROAS、调计划",
   "mark": "投",
   "keywords": [
    "广告",
    "投流",
    "预算",
    "roas",
    "gmv max",
    "花费"
   ],
   "duties": [
    "核对昨日广告花费",
    "找出亏钱的计划",
    "给出调价建议"
   ],
   "outputs": [
    "投流日报",
    "调整建议"
   ],
   "module": "energy-flow",
   "socket": "TikTok 广告账户（官方 MCP）",
   "executor": {
    "skill": "cap-tiktok-ads",
    "connected": false
   }
  },
  {
   "id": "service",
   "name": "客服专家",
   "title": "回买家、处理售后、收集差评",
   "mark": "客",
   "keywords": [
    "客服",
    "买家",
    "消息",
    "售后",
    "差评",
    "退款"
   ],
   "duties": [
    "回复买家消息",
    "整理差评原因",
    "更新常见问题"
   ],
   "outputs": [
    "差评分析",
    "客服话术"
   ],
   "module": "data-vortex",
   "socket": "Chatwoot 客服后台",
   "executor": {
    "skill": "cap-tiktok-service",
    "connected": false
   }
  },
  {
   "id": "finance",
   "name": "财务管家",
   "title": "每天算清楚到底赚没赚",
   "mark": "财",
   "keywords": [
    "对账",
    "利润",
    "成本",
    "财务",
    "回款",
    "账"
   ],
   "duties": [
    "核对平台回款",
    "计算贡献利润",
    "标记异常支出"
   ],
   "outputs": [
    "利润日报",
    "异常清单"
   ],
   "module": "neon-grid",
   "socket": "店铺结算导出表",
   "executor": {
    "skill": "cap-tiktok-shop",
    "connected": false
   }
  }
 ],
 "kpis": [
  {
   "key": "gmv",
   "label": "今日成交",
   "prefix": "$",
   "format": "money",
   "sim": {
    "start": 1280,
    "min": 0,
    "step": 60,
    "trend": 0.2
   }
  },
  {
   "key": "orders",
   "label": "今日订单",
   "unit": "单",
   "format": "int",
   "decimals": 0,
   "sim": {
    "start": 36,
    "min": 0,
    "step": 2,
    "trend": 0.3
   }
  },
  {
   "key": "roas",
   "label": "广告 ROAS",
   "format": "num",
   "decimals": 2,
   "sim": {
    "start": 2.4,
    "min": 0.8,
    "max": 5,
    "step": 0.08
   }
  },
  {
   "key": "content",
   "label": "今日内容",
   "unit": "条",
   "format": "int",
   "decimals": 0,
   "sim": {
    "start": 6,
    "perTask": 1,
    "roles": [
     "content"
    ]
   }
  },
  {
   "key": "done",
   "label": "AI 完成任务",
   "unit": "个",
   "format": "int",
   "decimals": 0,
   "sim": {
    "start": 0,
    "perTask": 1
   }
  }
 ],
 "flows": [
  {
   "id": "content",
   "name": "内容生产线",
   "stages": [
    "素材",
    "脚本",
    "制作",
    "检验",
    "分发"
   ]
  }
 ],
 "commands": {
  "placeholder": "一句话给团队派活，比如：找 5 个马来西亚的爆品",
  "presets": [
   "找 5 个马来西亚的爆品",
   "给新品写 3 条带货脚本",
   "看下今天广告花费",
   "整理昨天的差评",
   "算一下本周利润"
  ]
 },
 "sim": {
  "speed": 1,
  "autoGap": 14000,
  "seedTasks": [
   {
    "roleId": "scout",
    "title": "扫描马来西亚宠物类目热销榜"
   },
   {
    "roleId": "content",
    "title": "改写猫咪项圈爆款脚本"
   }
  ]
 },
 "live": {
  "enabled": false,
  "url": "data/live.json",
  "interval": 10000,
  "outbox": "/api/outbox"
 }
}
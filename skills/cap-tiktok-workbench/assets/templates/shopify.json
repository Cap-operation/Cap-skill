  "slogan": "三个人 · 七个 AI 岗位 · 卖向欧美",
  "mark": "示",
  "industry": "shopify",
  "markets": [
   "US",
   "DE",
   "GB",
   "FR"
  ],
  "team_size": 3,
  "audience": "team",
  "origin": "CN"
 },
 "theme": {
  "main_scene": "neon-grid",
  "palette": "ice",

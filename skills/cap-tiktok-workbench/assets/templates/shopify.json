   ],
   "module": "data-vortex",
   "executor": {
    "skill": "cap-tiktok-service",
    "connected": false
   }
  },
  {
   "id": "supply",
   "name": "供应链管家",
   "title": "库存、补货、物流",
   "mark": "供",
   "keywords": [
    "发货",
    "库存",
    "物流",
    "采购",
    "工厂",
    "补货"
   ],
   "duties": [
    "盯库存与补货",
    "跟进物流异常",
    "对接工厂交期"
   ],
   "outputs": [
    "补货单",
    "物流异常表"
   ],
   "module": "globe",
   "executor": {
    "skill": "cap-tiktok-shop",
    "connected": false
   }
  }
 ],
 "kpis": [
  {
   "key": "gmv",
   "label": "今日成交",
   "prefix": "$",
   "format": "money",
   "sim": {
    "start": 4200,
    "min": 0,
    "step": 120,
    "trend": 0.2
   }
  },
  {
   "key": "visitors",
   "label": "访客数",
   "format": "int",
   "decimals": 0,
   "sim": {
    "start": 2600,
    "min": 0,
    "step": 60,
    "trend": 0.3
   }
  },
  {
   "key": "cvr",
   "label": "转化率",
   "format": "pct",
   "decimals": 2,
   "sim": {
    "start": 0.021,
    "min": 0.005,
    "max": 0.05,
    "step": 0.001
   }
  },
  {
   "key": "done",
   "label": "AI 完成任务",
   "unit": "个",
   "format": "int",
   "decimals": 0,
   "sim": {
    "start": 0,
    "perTask": 1
   }
  }
 ],
 "flows": [
  {
   "id": "content",
   "name": "内容生产线",
   "stages": [
    "素材",
    "脚本",
    "制作",
    "检验",
    "分发"
   ]
  }
 ],
 "commands": {
  "placeholder": "一句话派活，比如：看下德国站这周转化",
  "presets": [
   "看下德国站这周转化",
   "给新款咖啡机找 3 个竞品",
   "整理昨天的差评",
   "查一下美国仓库存"
  ]
 },
 "sim": {
  "speed": 1.2
 },
 "live": {
  "enabled": false,
  "url": "data/live.json",
  "interval": 10000,
  "outbox": "/api/outbox"
 }
}
 "roles": [
  {
   "id": "chief",
   "name": "统筹助理",
   "title": "把老板的一句话拆成每个岗位的活",
   "mark": "统",
   "keywords": [
    "安排",
    "计划",
    "汇总",
    "日报",
    "周报",
    "统筹"
   ],
   "duties": [
    "拆解老板的指令",
    "汇总各岗位进度",
    "整理今日日报"
   ],
   "outputs": [
    "任务拆解单",
    "今日日报"
   ],
   "module": "node-matrix",
   "executor": {
    "skill": "cap-skill",
    "connected": false
   }
  },
  {
   "id": "scout",
   "name": "选品专家",

   "title": "盯预算、看 ROAS、调计划",
   "mark": "投",
   "keywords": [
    "广告",
    "投流",
    "预算",
    "roas",
    "花费"
   ],
   "duties": [
    "核对昨日广告花费",
    "找出亏钱的计划",
    "给出调整建议"
   ],
   "outputs": [
    "投流日报",
    "调整建议"
   ],
   "module": "node-matrix",
   "socket": "广告账户",
   "executor": {
    "skill": "cap-tiktok-ads",
    "connected": false
   }
  },
  {
   "id": "content",
